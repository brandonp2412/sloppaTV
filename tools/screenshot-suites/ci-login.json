    {"action": "key", "key": "BACK", "wait_seconds": 1},
    {"action": "key", "key": "DPAD_DOWN"},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 1},
    {"action": "text", "value": "viewer", "wait_seconds": 1},
    {"action": "key", "key": "BACK", "wait_seconds": 1},
    {"action": "key", "key": "DPAD_DOWN"},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 1},
