{
  "name": "ci-store-listing",
  "steps": [
    {"action": "restart", "wait_seconds": 3},
    {"action": "capture", "name": "01-login"},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 1},
    {"action": "text", "value": "http://127.0.0.1:1024", "wait_seconds": 1},
    {"action": "key", "key": "ENTER", "wait_seconds": 1},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 1},
    {"action": "text", "value": "viewer", "wait_seconds": 1},
    {"action": "key", "key": "ENTER", "wait_seconds": 1},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 1},
    {"action": "text", "value": "demo", "wait_seconds": 1},
    {"action": "key", "key": "ENTER", "wait_seconds": 1},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 1},
    {"action": "fixture_log", "contains": "POST /Users/AuthenticateByName", "timeout_seconds": 8},
    {"action": "fixture_log", "contains": "GET /Users/fixture-user/Views", "timeout_seconds": 8},
    {"action": "wait", "wait_seconds": 2},
    {"action": "capture", "name": "02-home"},
    {"action": "key", "key": "DPAD_UP"},
    {"action": "key", "key": "DPAD_RIGHT"},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 1},
    {"action": "capture", "name": "03-search"},
    {"action": "key", "key": "SEARCH", "wait_seconds": 1},
    {"action": "text", "value": "Bunny", "wait_seconds": 1},
    {"action": "key", "key": "ENTER", "wait_seconds": 1},
    {"action": "fixture_log", "contains": "SearchTerm=Bunny", "timeout_seconds": 8},
    {"action": "wait", "wait_seconds": 1},
    {"action": "capture", "name": "04-search-results"},
    {"action": "restart", "wait_seconds": 4},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 2},
    {"action": "capture", "name": "05-browse"},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 2},
    {"action": "capture", "name": "06-details"},
    {"action": "restart", "wait_seconds": 4},
    {"action": "key", "key": "DPAD_UP"},
    {"action": "key", "key": "DPAD_RIGHT"},
    {"action": "key", "key": "DPAD_RIGHT"},
    {"action": "key", "key": "DPAD_CENTER", "wait_seconds": 2},
    {"action": "capture", "name": "07-settings"},
    {"action": "key", "key": "DPAD_DOWN", "wait_seconds": 1},
    {"action": "capture", "name": "08-settings-options"}
  ]
}
